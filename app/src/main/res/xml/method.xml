<?xml version="1.0" encoding="utf-8"?>
<!-- Declaration of the Z keyboard input method. The subtypes are what the system's language
     switcher offers; the service picks its letter layout from the active subtype. -->
<input-method xmlns:android="http://schemas.android.com/apk/res/android"
    android:supportsSwitchingToNextInputMethod="true">
    <subtype
        android:label="@string/keyboard_subtype_tr"
        android:imeSubtypeLocale="tr_TR"
        android:languageTag="tr-TR"
        android:imeSubtypeMode="keyboard"
        android:isAsciiCapable="false" />
    <subtype
        android:label="@string/keyboard_subtype_en"
        android:imeSubtypeLocale="en_US"
        android:languageTag="en-US"
        android:imeSubtypeMode="keyboard"
        android:isAsciiCapable="true" />
    <subtype
        android:label="@string/keyboard_subtype_fr"
        android:imeSubtypeLocale="fr_FR"
        android:languageTag="fr-FR"
        android:imeSubtypeMode="keyboard"
        android:isAsciiCapable="false" />
    <subtype
        android:label="@string/keyboard_subtype_de"
        android:imeSubtypeLocale="de_DE"
        android:languageTag="de-DE"
        android:imeSubtypeMode="keyboard"
        android:isAsciiCapable="false" />
    <subtype
        android:label="@string/keyboard_subtype_es"
        android:imeSubtypeLocale="es_ES"
        android:languageTag="es-ES"
        android:imeSubtypeMode="keyboard"
        android:isAsciiCapable="false" />
    <subtype
        android:label="@string/keyboard_subtype_it"
        android:imeSubtypeLocale="it_IT"
        android:languageTag="it-IT"
        android:imeSubtypeMode="keyboard"
        android:isAsciiCapable="true" />
</input-method>
