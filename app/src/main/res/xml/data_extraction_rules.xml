<?xml version="1.0" encoding="utf-8"?>
<!--
  What may leave the phone (Android 12+): the same list as backup_rules.xml, applied to both a
  cloud backup and a transfer to a new phone. See that file for why each one is here.

  Device transfer is treated exactly like a cloud backup. It is a shorter journey, but the same
  data, and a launcher has no business moving somebody's mail and notes around on its own.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="zune_secrets.xml" />
        <exclude domain="file" path="datastore/email.preferences_pb" />
        <exclude domain="file" path="email/" />
        <exclude domain="file" path="datastore/browsing.preferences_pb" />
        <exclude domain="file" path="datastore/cloud_accounts.preferences_pb" />
        <exclude domain="file" path="datastore/keyboard.preferences_pb" />
        <exclude domain="file" path="datastore/notes.preferences_pb" />
        <exclude domain="file" path="notes_audio/" />
        <exclude domain="file" path="notes_images/" />
        <exclude domain="file" path="datastore/calendar_events.preferences_pb" />
        <exclude domain="file" path="datastore/phone.preferences_pb" />
        <exclude domain="file" path="datastore/weather.preferences_pb" />
        <!-- The reading list and the copies of its pages kept to read offline: places visited. -->
        <exclude domain="file" path="reading_list.json" />
        <exclude domain="file" path="reading/" />
        <!-- Where each video was left: what was watched. -->
        <exclude domain="sharedpref" path="video_resume.xml" />
        <!-- Fetched again from the network whenever it is wanted. -->
        <exclude domain="file" path="news_cache.json" />
        <exclude domain="file" path="adblock_hosts.txt" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="zune_secrets.xml" />
        <exclude domain="file" path="datastore/email.preferences_pb" />
        <exclude domain="file" path="email/" />
        <exclude domain="file" path="datastore/browsing.preferences_pb" />
        <exclude domain="file" path="datastore/cloud_accounts.preferences_pb" />
        <exclude domain="file" path="datastore/keyboard.preferences_pb" />
        <exclude domain="file" path="datastore/notes.preferences_pb" />
        <exclude domain="file" path="notes_audio/" />
        <exclude domain="file" path="notes_images/" />
        <exclude domain="file" path="datastore/calendar_events.preferences_pb" />
        <exclude domain="file" path="datastore/phone.preferences_pb" />
        <exclude domain="file" path="datastore/weather.preferences_pb" />
        <!-- The reading list and the copies of its pages kept to read offline: places visited. -->
        <exclude domain="file" path="reading_list.json" />
        <exclude domain="file" path="reading/" />
        <!-- Where each video was left: what was watched. -->
        <exclude domain="sharedpref" path="video_resume.xml" />
        <!-- Fetched again from the network whenever it is wanted. -->
        <exclude domain="file" path="news_cache.json" />
        <exclude domain="file" path="adblock_hosts.txt" />
    </device-transfer>
</data-extraction-rules>
