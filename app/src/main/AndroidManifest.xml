<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Replaced by the READ_MEDIA_* permissions from Android 13 on. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <!-- The Files hub opens .apk files and the Internet hub opens the ones it downloaded; without
         this the system installer does not even appear. The person still allows the launcher as
         an unknown source in settings, and still confirms every install. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- "Kaldır" in the app list opens the system's own uninstall dialog; since Android 9 that
         dialog does not open for an app without this. The person still confirms every removal. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <uses-permission android:name="android.permission.GET_ACCOUNTS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Exact alarms, granted by the user ("alarms and reminders"). Not USE_EXACT_ALARM: Google
         Play keeps that one for apps whose main purpose is an alarm clock or a calendar. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Only for the name of the Wi-Fi network on the connections page: Android gives it to no
         app without precise location. The weather keeps to a rounded, approximate position. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- An alarm that only makes a noise is no use to somebody who sleeps with the phone silent. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <!-- Android only offers the messaging role to an app that can take delivery of picture
         messages too, so these three stay even though the launcher only files a picture message
         and does not fetch it. WRITE_SMS is what lets the inbox be written at all. -->
    <uses-permission android:name="android.permission.RECEIVE_MMS" />
    <uses-permission android:name="android.permission.RECEIVE_WAP_PUSH" />
    <uses-permission android:name="android.permission.WRITE_SMS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- A ringing call has to come up over whatever is on screen, and over the lock screen. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- A call in progress has to be a foreground service: Android refuses a CallStyle
         notification that belongs to neither a foreground service nor a full screen intent. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <uses-permission android:name="android.permission.WRITE_CALL_LOG" />
    <!-- The volume bar's silent mode is a do-not-disturb change, which Android only allows an app
         the user has let into its notification policy. Without it the bar stops at vibrate. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- The action center: Wi-Fi and Bluetooth state for its squares, brightness and rotation lock. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- The phone link finds a TV on the Wi-Fi by mDNS, which needs multicast. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <!-- Only for the names of the Bluetooth devices connected now, on the connections page; the
         launcher never scans, pairs or connects. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" tools:ignore="ProtectedPermissions" />

    <!-- Camera hub, and the keyboard's dictation -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Before Android 10 a picture has to be written to shared storage by hand. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- A television: no touch screen, and the TV's own launcher lists the app by its banner. -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!--
      Asking for these permissions is otherwise taken as "this app needs the hardware", and Play
      then hides it from every device without it: a launcher would be missing from Wi-Fi-only
      tablets over the dialler, and from anything without a microphone or a location fix. Each
      hub checks for itself and does without; none of it is required to run a Start screen.
    -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.network" android:required="false" />

    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />

        <!-- Icon packs announce themselves with one of these; without them they are invisible. -->
        <intent><action android:name="org.adw.launcher.THEMES" /></intent>
        <intent><action android:name="org.adw.launcher.icons.ACTION_PICK_ICON" /></intent>
        <intent><action android:name="com.novalauncher.THEME" /></intent>
        <intent><action android:name="com.gau.go.launcherex.theme" /></intent>
        <intent><action android:name="com.anddoes.launcher.THEME" /></intent>
        <intent><action android:name="ch.deletescape.lawnchair.ICONPACK" /></intent>
        <intent><action android:name="com.teslacoilsw.launcher.THEME" /></intent>
    </queries>

    <application
        android:name=".ZuneLauncherApp"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:hardwareAccelerated="true"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ZuneLauncher">
        <activity
            android:name=".MainActivity"
            android:banner="@drawable/tv_banner"
            android:hardwareAccelerated="true"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ZuneLauncher"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|fontScale|layoutDirection|keyboard|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>

            <!-- Default Phone App (Dialer Role) -->
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="tel" />
            </intent-filter>
            <!-- VIEW only: an exported screen must not place a call (CALL) on another app's
                 say-so. A tel: link opens the keypad with the number typed in. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tel" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.CALL_BUTTON" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- sms: links are ComposeSmsActivity's; it hands them to the Messaging hub. -->

            <!-- Default Browser App -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
        </activity>

        <service android:name=".data.service.SocialNotificationListener"
            android:label="@string/label_social_listener"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Answering and turning down a call from its notification. -->
        <!-- A clock that moved — a new time zone, a set clock, an update — re-books every alarm. -->
        <receiver
            android:name=".data.service.TimeChangeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".data.service.CallActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.serkantkn.zeta.CALL_ANSWER" />
                <action android:name="com.serkantkn.zeta.CALL_DECLINE" />
            </intent-filter>
        </receiver>

        <!-- The phone link (data/link): who is calling or writing, told to a paired TV. -->
        <receiver
            android:name=".data.link.PhoneLinkCallReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".data.link.PhoneLinkSmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- Telecom tells the phone app, and nobody else, how many calls went unanswered. -->
        <receiver
            android:name=".data.service.MissedCallReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.telecom.action.SHOW_MISSED_CALLS_NOTIFICATION" />
            </intent-filter>
        </receiver>

        <!-- Telecom InCallService: the launcher's own call screen, while it is the default phone app -->
        <service
            android:name=".data.service.WpInCallService"
            android:permission="android.permission.BIND_INCALL_SERVICE"
            android:foregroundServiceType="phoneCall"
            android:exported="true">
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_UI"
                android:value="true" />
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
        </service>

        <service
            android:name=".data.service.MusicPlaybackService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- Volume keys over other apps: filters key events so the Windows Phone volume bar replaces the system panel -->
        <service
            android:name=".data.service.ZuneKeyAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true"
            android:label="@string/label_key_service">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>


        <!-- Invisible helper: the keyboard's dictation panel asks for the microphone through it -->
        <activity
            android:name=".ui.keyboard.KeyboardMicPermissionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:enabled="@bool/zune_keyboard_enabled"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- What Pro adds, and Google Play's purchase sheet for it. -->
        <activity
            android:name=".ui.pro.ProActivity"
            android:exported="false"
            android:theme="@style/Theme.ZuneLauncher" />

        <!-- System-wide Windows Phone keyboard (premium only: disabled via @bool in the free flavour) -->
        <service
            android:name=".data.service.ZuneKeyboardService"
            android:label="@string/keyboard_name"
            android:enabled="@bool/zune_keyboard_enabled"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <receiver android:name=".data.service.AlarmReceiver" android:exported="false" />

        <receiver android:name=".data.service.TimerReceiver" android:exported="false" />

        <receiver android:name=".data.service.EventReminderReceiver" android:exported="false" />

        <receiver
            android:name=".data.service.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".data.service.EmailSyncReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- The mail sync itself: the alarm's receiver hands it here, where it has minutes rather than seconds. -->
        <service
            android:name=".data.service.EmailSyncJobService"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />

        <!-- mailto: links and share sheet target: "paylaş -> E-posta" -->
        <activity
            android:name=".ui.screens.email.ComposeEmailActivity"
            android:exported="true"
            android:label="@string/hub_email"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SENDTO" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mailto" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- Share sheet target: "paylaş -> Notlar" -->
        <activity
            android:name=".ui.screens.notes.ReceiveNoteActivity"
            android:exported="true"
            android:label="@string/label_notes_share"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- "A new note", as the phone's notes app: a stylus button, a lock screen shortcut,
                 another app asking for one. Where Android has a default notes app, this is what
                 lets the launcher be it. -->
            <intent-filter>
                <action android:name="android.intent.action.CREATE_NOTE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- SMS Receivers & Services for Default SMS App eligibility -->
        <receiver
            android:name=".data.receiver.SmsReceiver"
            android:permission="android.permission.BROADCAST_SMS"
            android:exported="true">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_DELIVER" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".data.receiver.MmsReceiver"
            android:permission="android.permission.BROADCAST_WAP_PUSH"
            android:exported="true">
            <intent-filter>
                <action android:name="android.provider.Telephony.WAP_PUSH_DELIVER" />
                <data android:mimeType="application/vnd.wap.mms-message" />
            </intent-filter>
        </receiver>

        <!-- What the phone says once it has sent a picture message or fetched one -->
        <receiver
            android:name=".data.receiver.MmsResultReceiver"
            android:exported="false" />

        <!-- What the network says about a message after it has left: went out, arrived, failed -->
        <receiver
            android:name=".data.receiver.SmsStatusReceiver"
            android:exported="false" />

        <!-- Replying to a message, or waving it away, from its notification -->
        <receiver
            android:name=".data.service.MessageActionReceiver"
            android:exported="false" />

        <!-- SMS Compose Activity for Default SMS App eligibility -->
        <activity
            android:name=".ui.screens.messaging.ComposeSmsActivity"
            android:exported="true"
            android:label="@string/label_sms_compose"
            android:theme="@style/Theme.ZuneLauncher">
            <intent-filter>
                <action android:name="android.intent.action.SENDTO" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
            <!-- Text only: the launcher cannot send a picture message, so it does not offer to
                 take a picture from the share sheet and then drop it. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <service
            android:name=".data.service.HeadlessSmsSendService"
            android:permission="android.permission.SEND_RESPOND_VIA_MESSAGE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.RESPOND_VIA_MESSAGE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </service>

        <!-- Its own task and no entry in recents: an alarm that rang an hour ago must not sit in
             the app switcher, nor be brought back when the launcher's task is. -->
        <activity
            android:name=".ui.screens.clock.AlarmActivity"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:taskAffinity=""
            android:launchMode="singleTop"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.ZuneLauncher"
            android:exported="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|fontScale|layoutDirection|keyboard|keyboardHidden" />

        <!-- The launcher's own video player. A task of its own, since the launcher is the home
             screen and a home screen cannot shrink into a corner; this can, and keeps playing in a
             small window when it is left. It also offers itself to other apps for their videos. -->
        <activity
            android:name=".ui.screens.video.VideoPlayerActivity"
            android:taskAffinity="${applicationId}.video"
            android:launchMode="singleTask"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:theme="@style/Theme.ZuneLauncher"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|fontScale|layoutDirection|keyboard|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="video/*" />
            </intent-filter>
            <!-- A video on the web handed over by address, played as it arrives. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>

        <!-- The launcher as the phone's gallery: a picture from the library opens in the pictures
             hub, anything else in the hub's own viewer, on its own. -->
        <activity
            android:name=".ui.openwith.ImageViewerActivity"
            android:label="@string/pictures_hub"
            android:taskAffinity="${applicationId}.viewer"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.ZuneLauncher"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|fontScale|layoutDirection|keyboard|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- The launcher as the phone's music player: a song another app opens plays in the music hub. -->
        <activity
            android:name=".ui.openwith.OpenAudioActivity"
            android:label="@string/music_hub"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/ogg" />
                <data android:mimeType="application/x-flac" />
            </intent-filter>
        </activity>

        <!-- The hubs as the phone's apps of their kind: Android asks for "the gallery", "the music
             app", "the calendar" by category. Each alias is one category, and its name tells
             HubShortcutActivity which hub to open. -->
        <activity
            android:name=".ui.openwith.HubShortcutActivity"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:exported="false" />
        <activity-alias android:name=".AppGallery" android:targetActivity=".ui.openwith.HubShortcutActivity" android:label="@string/pictures_hub" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.APP_GALLERY" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".AppMusic" android:targetActivity=".ui.openwith.HubShortcutActivity" android:label="@string/music_hub" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.APP_MUSIC" />
